
# Server Port - Backend server kis port par run hoga
PORT=5000

# MongoDB URL - MongoDB database se connect karne ke liye
MONGODB_URL=your_mongodb_connection_string

# Email User - OTP aur notification email bhejne ke liye Gmail address
EMAIL_USER=your_email@gmail.com

# Email Password - Gmail ka 16-digit App Password
EMAIL_PASS=your_gmail_app_password

# JWT Secret - User authentication token generate aur verify karne ke liye secret key
JWT_SECRET=your_secret_key
